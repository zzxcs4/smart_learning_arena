<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzx.exam.mapper.DocumentMapper">

    <resultMap id="BaseResultMap" type="com.zzx.exam.entity.Document">
            <id property="id" column="id" />
            <result property="fileName" column="file_name" />
            <result property="fileType" column="file_type" />
            <result property="fileSize" column="file_size" />
            <result property="storagePath" column="storage_path" />
            <result property="uploadUser" column="upload_user" />
            <result property="uploadTime" column="upload_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,file_name,file_type,file_size,storage_path,upload_user,
        upload_time,update_time,is_deleted
    </sql>
    <select id="countByMap" resultType="java.lang.Integer">
        select count(id) from document
        <where>

                and `type` = 1

            <if test="begin != null">
                and upload_time &gt; #{begin}
            </if>
            <if test="end != null">
                and upload_time &lt; #{end}
            </if>
        </where>
    </select>
</mapper>
