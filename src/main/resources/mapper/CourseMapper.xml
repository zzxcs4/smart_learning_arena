<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzx.exam.mapper.CourseMapper">

    <resultMap id="BaseResultMap" type="com.zzx.exam.entity.Course">
            <id property="id" column="id" />
            <result property="courseName" column="course_name" />
            <result property="teacherName" column="teacher_name" />
            <result property="courseIntro" column="course_intro" />
            <result property="semester" column="semester" />
            <result property="courseCover" column="course_cover" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,course_name,teacher_name,course_intro,semester,course_cover,
        create_time,update_time,is_deleted
    </sql>
</mapper>
